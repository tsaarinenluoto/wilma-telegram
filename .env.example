WILMA_URL=https://yourcity.inschool.fi
WILMA_USERNAME=your_wilma_username
WILMA_PASSWORD=your_wilma_password

DAISY_URL=https://yourcity.daisyfamily.fi
DAISY_USERNAME=your_daisy_username
DAISY_PASSWORD=your_daisy_password

TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# How often to check for new messages (seconds)
POLL_INTERVAL=900

# Set to 1 on first run to mark existing messages as seen without notifying
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
INITIAL_SYNC=1

# Optional: generate calendar event attachments from message text
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Optional: add events directly to iPhone Calendar via iCloud
# Create an app-specific password at https://appleid.apple.com
# ICLOUD_APPLE_ID=you@icloud.com
# ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# ICLOUD_CALENDAR=Koti
